{
  "name": "@mcp-devices/plugin-debug",
  "version": "4.4.1",
  "description": "Runtime debug plugin for mcp-devices (Android JDWP + iOS LLDB).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && chmod +x bin/ios-debug-daemon.py"
  },
  "keywords": [
    "mcp",
    "mcp-devices",
    "plugin",
    "debug",
    "jdwp",
    "lldb",
    "android",
    "ios"
  ],
  "author": "Alex Gladkov",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "bin"
  ],
  "mcpDevicesPlugin": {
    "id": "debug",
    "name": "Debug",
    "version": "4.4.1",
    "apiVersion": "1",
    "capabilities": [
      "meta-tools"
    ],
    "description": "Runtime debugger for Android (JDWP) and iOS Simulator (LLDB): breakpoints, event polling, frame inspection, eval, step, set-var."
  },
  "dependencies": {
    "@mcp-devices/plugin-api": "1.1.0",
    "mcp-devices": "4.4.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGladkov/claude-in-mobile.git",
    "directory": "packages/plugin-debug"
  }
}
