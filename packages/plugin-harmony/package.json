{
  "name": "@mcp-devices/plugin-harmony",
  "version": "4.4.1",
  "description": "HarmonyOS Next platform plugin for mcp-devices (HDC and ArkXTest).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "mcp",
    "mcp-devices",
    "plugin",
    "harmonyos",
    "openharmony",
    "hdc"
  ],
  "author": "Alex Gladkov",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "mcpDevicesPlugin": {
    "id": "harmony",
    "name": "HarmonyOS Next",
    "version": "4.4.1",
    "apiVersion": "1",
    "capabilities": [
      "screen",
      "input",
      "ui",
      "shell",
      "permissions",
      "appLifecycle",
      "logs",
      "url",
      "fileTransfer",
      "deviceMgmt"
    ],
    "tools": [
      "harmony_launch_ability",
      "harmony_arkweb_inspect",
      "harmony_arkweb_close",
      "harmony_sandbox_list",
      "harmony_sandbox_read",
      "harmony_sandbox_push",
      "harmony_sandbox_pull",
      "harmony_test"
    ],
    "description": "HarmonyOS Next automation via HDC and ArkXTest (screen, input, UI, apps, permissions, shell, logs, files, ArkWeb, app sandbox, tests)"
  },
  "dependencies": {
    "@mcp-devices/plugin-api": "1.1.0",
    "mcp-devices": "4.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGladkov/claude-in-mobile.git",
    "directory": "packages/plugin-harmony"
  }
}
