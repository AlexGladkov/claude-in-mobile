{
  "name": "@mcp-devices/plugin-aurora",
  "version": "4.4.1",
  "description": "Aurora OS platform plugin for mcp-devices (audb).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "mcp",
    "mcp-devices",
    "plugin",
    "aurora",
    "audb"
  ],
  "author": "Alex Gladkov",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "mcpDevicesPlugin": {
    "id": "aurora",
    "name": "Aurora OS",
    "version": "4.4.1",
    "apiVersion": "1",
    "capabilities": [
      "screen",
      "input",
      "shell",
      "appLifecycle",
      "logs",
      "fileTransfer",
      "deviceMgmt"
    ],
    "description": "Aurora OS automation via audb (screen, input, app lifecycle, shell, logs)"
  },
  "dependencies": {
    "@mcp-devices/plugin-api": "1.1.0",
    "mcp-devices": "4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGladkov/claude-in-mobile.git",
    "directory": "packages/plugin-aurora"
  }
}
