{
  "name": "@mcp-devices/plugin-web",
  "version": "4.4.1",
  "description": "Web/browser platform plugin for mcp-devices (Chrome DevTools Protocol).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "mcp",
    "mcp-devices",
    "plugin",
    "browser",
    "cdp",
    "web"
  ],
  "author": "Alex Gladkov",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist"
  ],
  "mcpDevicesPlugin": {
    "id": "web",
    "name": "Web (Chrome)",
    "version": "4.4.1",
    "apiVersion": "1",
    "capabilities": [
      "screen",
      "input",
      "ui"
    ],
    "description": "Browser automation via Chrome DevTools Protocol"
  },
  "dependencies": {
    "@mcp-devices/plugin-api": "1.1.0",
    "chrome-launcher": "^1.2.0",
    "mcp-devices": "4.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexGladkov/claude-in-mobile.git",
    "directory": "packages/plugin-web"
  }
}
